#!/bin/sh
set -eu
: "${BACKEND_DOMAIN:?BACKEND_DOMAIN is not set}"
D="/etc/letsencrypt/live/$BACKEND_DOMAIN"
PREVIOUS=''
while :; do
  if [ -r "$D/fullchain.pem" ] && [ -r "$D/privkey.pem" ]; then
    CURRENT="$(sha256sum "$D/fullchain.pem" "$D/privkey.pem" | sha256sum | cut -d ' ' -f1)"
    if [ -n "$PREVIOUS" ] && [ "$CURRENT" != "$PREVIOUS" ]; then
      if s6-svc -h /etc/s6/stunnel; then
        echo 'Certificate changed: stunnel reloaded'
      else
        echo 'Certificate changed; stunnel reload failed; retrying' >&2
        sleep 20
        continue
      fi
    fi
    PREVIOUS="$CURRENT"
  fi
  sleep 300
done
